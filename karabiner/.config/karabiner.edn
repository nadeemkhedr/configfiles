{:default true

 :alone 500
 :delay 200
 :held 500
 :sim 200
 :simlayer-threshold 222
 :modifiers {;;
             :super-hyper [:command :shift :control :option :fn]
             :hyper [:command :shift :control :option]
             :cos [:command :shift :option]
             :cst [:command :shift :control]
             :co [:command :option]
             :cs [:command :shift]
             :ct [:command :control]
             :to [:control :option]
             :ts [:control :shift]
             :os [:option :shift]
             ;;
             }
 :froms {;; alias
         :delete {:key :delete_or_backspace}
         :return {:key :return_or_enter}
         :tilde {:key :grave_accent_and_tilde}

         ;; colemak froms (for easier mnemonics)
         :-q {:key :q}
         :-w {:key :w}
         :-f {:key :e}
         :-p {:key :r}
         :-g {:key :t}
         :-j {:key :y}
         :-l {:key :u}
         :-u {:key :i}
         :-y {:key :o}
         :-semicolon {:key :p}

         :-a {:key :a}
         :-r {:key :s}
         :-s {:key :d}
         :-t {:key :f}
         :-d {:key :g}
         :-h {:key :h}
         :-n {:key :j}
         :-e {:key :k}
         :-i {:key :l}
         :-o {:key :semicolon}

         :-z {:key :z}
         :-x {:key :x}
         :-c {:key :c}
         :-v {:key :v}
         :-b {:key :b}
         :-k {:key :n}
         :-m {:key :m}
         ;;
         }

 :tos {;;
       :delete {:key :delete_or_backspace}
       :return {:key :return_or_enter}
       :tilde {:key :grave_accent_and_tilde}

       ;; named symbols
       :open_brace {:key :open_bracket :modi :shift}
       :close_brace {:key :close_bracket :modi :shift}
       :open_paren {:key :9 :modi :shift}
       :close_paren {:key :0 :modi :shift}
       :less_than {:key :comma :modi :shift}
       :greater_than {:key :period :modi :shift}

       ;; general
       :emoji_picker {:key :spacebar :modi :ct} ; !CTspacebar
       :switch_windows {:key :grave_accent_and_tilde :modi :command}
       :prev_app {:key :tab :modi :cs :lazy true}
       :next_app {:key :tab :modi :command :lazy true}
       :reopen_tab {:key t :modi :cs} ; brave/code
       :zoom_in {:key :equal_sign :modi :co}
       :zoom_out {:key :hyphen :modi :co}

       ;; vscode
       :go_to_file {:key :p :modi :command}
       :command_palette {:key :p :modi :cs}

       :code_tab_prev [{:key k :modi :command}
                       {:key left_arrow :modi :co}] ; prev tab in group
       :code_tab_next [{:key k :modi :command}
                       {:key right_arrow :modi :co}] ; next tab in group
       ;; brave
       :prev_tab {:key tab :modi :ts}
       :next_tab {:key tab :modi :control}
       :tab_move_left {:key page_up :modi :ts}
       :tab_move_right {:key page_down :modi :ts}
       :new_tab {:key t :modi :command}
       :close_tab {:key w :modi :command}
       :open_dev_tools {:key :i :modi :co} ; :!COl
       :focus_omnibar {:key :l :modi :command}
       :refresh {:key r :modi :command}
       :private_mode {:key n :modi :cs}
       :browser_1pass {:key x :modi :cs}

       ;; scripts
       ;; ~/scripts/bml.sh spawns a new ghostty instance (also used by BetterMouse);
       ;; the faster AppleScript alternative lives in ~/scripts/bml-popup.sh
       :bml {:shell "~/scripts/bml.sh"}
       ;;
       }

 :templates {;;
             :activate "osascript -e '
                        tell application \"%s\" 
                           activate
                        end tell
                        '"
             :launch "osascript -e '
                        tell application \"%s\" 
                           reopen
                           activate
                        end tell
                        '"
             :open-new-osa "osascript -e '
                        tell application \"%s\" 
                          if it is running then
                            activate
                            tell application \"System Events\" to keystroke \"n\" using {command down}
                          else
                            activate
                          end if
                        end tell
                      '"
             :open-new "open -n \"%s\""
             :quit "osascript -e '
                        tell application \"%s\" 
                          if its running then
                            quit
                          end if
                        end tell
                      '"
             :paste "osascript -e '
                        set the clipboard to \"%s\"
                        tell application \"System Events\"
                                keystroke \"v\" using command down
                        end tell
                '"
             ;;
             }

 :applications {;;
                :chromes ["com.brave.Browser", "com.google.Chrome"]
                :arc ["company.thebrowser.Browser"]
                :code ["com.microsoft.VSCode", "com.todesktop.230313mzl4w4u92"] ; vscode , cursor
                :slack ["com.tinyspeck.slackmacgap"]
                :messenger ["com.facebook.archon"]
                :terminals ["com.apple.Terminal", "com.googlecode.iterm2", "io.alacritty", "net.kovidgoyal.kitty", "com.github.wez.wezterm", "com.mitchellh.ghostty"]
                :rex ["com.superlogical.rex"] ; rex terminal multiplexer (beta shares the same bundle id)
                :obsidian ["md.obsidian"]
                :todoist ["com.todoist.mac.Todoist"]
                :finder ["com.apple.finder"]
                :godot ["org.godotengine.godot"]
                ;;
                }
 ;; Layers Are Typically "Thumb Keys" or "Pinky Keys"
 :layers {;;
          :escape-mode {:key :escape :alone {:key :escape}}
          :tab-mode {:key :tab, :alone {:key :tab}}
          :launch-mode {:key :f24 :alone {:key :spacebar :modi :left_option}}}
 :simlayers {;;
             :a-mode {:key :a} ; app specific // tmux, chrome
             :emoji-mode {:key :z}
             :spacebar-mode {:key :spacebar}
             ;;
             }

 :main [;;

        {:des "global"
         :rules [[:left_shift :left_shift nil {:alone :delete_or_backspace}]
                 [:right_shift :right_shift nil {:alone :delete_forward}]
                 ; change profiles in karabiner
                 [:!!open_bracket "'/Library/Application Support/org.pqrs/Karabiner-Elements/bin/karabiner_cli' --select-profile 'QWERTY'"]
                 [:!!close_bracket "'/Library/Application Support/org.pqrs/Karabiner-Elements/bin/karabiner_cli' --select-profile 'Default'"]
                 ; hold left_option + tap right_option -> switch to QWERTY profile
                 [:!Oright_option "'/Library/Application Support/org.pqrs/Karabiner-Elements/bin/karabiner_cli' --select-profile 'QWERTY'"]
                 ; both cmds will be f12
                 ;[{:key :right_command :modi {:mandatory [:left_command] :optional  [:any]}} :f12]
                 

                 ; map clicking on right-command or clicking on left option would show `leaderkey`
                 [:right_command :right_command nil {:alone :!Ospacebar}]
                 [:left_option :left_option nil {:alone :!Ospacebar}]

                 ; caps_lock also activates escape-mode (for keyboards with a caps_lock key)
                 [:caps_lock ["escape-mode" 1] nil {:afterup ["escape-mode" 0] :alone :escape}]

                 ; hyper-v runs bml; reuse :bml in other sections to bind it elsewhere
                 ;[:!!v :bml]
                 ]}

        {:des "finder"
         :rules [:finder
                 [:condi :finder :a-mode]
                 [:-t :!Ct]
                 [:-n :prev_tab]
                 [:-e :next_tab]
                 [:delete  :close_tab]
                 ;;
                 ]}
        {:des "slack-shortcuts"
         :rules [;;
                 [:condi :slack]
                 [:left_command :left_command nil {:alone :!Ct}]
                 ;;
                 ]}

        {:des "messenger-shortcuts"
         :rules [;;
                 [:condi :messenger]
                 [:left_command :left_command nil {:alone :!Ck}]
                 [:condi :messenger :a-mode]

                 [:-n :!Copen_bracket]
                 [:-e :!Cclose_bracket]

                 [:-l :!C1]
                 [:-u :!C2]
                 [:-y :!C3]
                 [:-semicolon :!C4]
                 ;;
                 ]}

        {:des "chromes-shortcuts"
         :rules [:chromes
                 ;; [:left_command :left_command nil {:alone [:!Ct]}]
                 ;; [:left_option :left_option nil {:alone [:!Cw]}]
                 [:condi :chromes :a-mode]
                 [:-b :!Op] ; picture in picture by chrome plugin
                 [:-n :prev_tab]
                 [:-e :next_tab]
                 [:-w :!CTSw] ; this is a custom shortcut in chrome to move tab to new window
                 [:-o :!CSa] ; search tabs
                 [:-m :tab_move_left]
                 [:comma :tab_move_right]
                 [:-h :zoom_in]
                 [:-d :zoom_out]
                 [:-s :reopen_tab]
                 [:-t :new_tab]
                 [:-l :focus_omnibar]
                 [:-i :open_dev_tools]
                 [:-r :refresh]
                 [:delete  :close_tab]
                 [:-p :private_mode]
                 [:-u :browser_1pass]
                 ;;
                 ]}

        {:des "godot-shortcuts"
         :rules [:godot
                 [:condi :godot :a-mode]

                 [:-o :!CTo] ; go to files
                 [:-h :f1] ; need to remap search help in godot to f1
                 ]}

        {:des "code-shortcuts"
         :rules [:code
                 [:left_command :left_command nil {:alone :command_palette}]
                 [:right_command :right_command nil {:alone :go_to_file}]

                 [:condi :code :a-mode]
                 [:-i :!Tgrave_accent_and_tilde] ; toggle terminal
                 [:-n :code_tab_prev]
                 [:-e :code_tab_next]
                 [:-x :close_tab]
                 [:-s :reopen_tab]
                 [:-t :!Cn] ; a-t creates an untitled file
                 [:comma :!Ccomma] ; settings
                 [:-v :!Cbackslash] ; vertical split
                 ;;
                 ]}

        {:des "obsidian"
         :rules [:obsidian
                 [:left_command :left_command nil {:alone {:key :o :modi :command}}]
                 [:right_command :right_command nil {:alone {:key :p :modi :command}}]
                 ;;
                 ]}

        {:des "todoist"
         :rules [:todoist
                 [:left_command :left_command nil {:alone {:key :k :modi :command}}]
                 ;;
                 ]}

        {:des "terminals-shortcuts"
         :rules [:terminals
                 [:condi :terminals :a-mode] ; tmux keys
                 [:-g [:!Ta :g]]
                 [:-f [:!Ta :f]]
                 [:-j [:!Ta :j]] ; move between panes
                 [:-k [:!Ta :k]]
                 [:-h [:!Ta :h]]
                 [:-l [:!Ta :l]]
                 [:-t [:!Ta :t]]
                 [:-semicolon [:!Ta :!Sl]] ; move between sessions
                 [:-o [:!Ta :z]] ; toggle max/k on a pane
                 [:-x [:!Ta :x]] ; kill pane
                 [:delete [:!Ta :x]] ; kill pane
                 [:-r [:!Ta :comma]] ; rename pane
                 [:-c [:!Ta :c]] ; create new window
                 [:-s [:!Ta :b]] ; toggle sidebar (herdr)
                 [:hyphen [:!Ta :hyphen]] ; split down
                 [:-v [:!Ta :!S5]] ; split h
                 [:spacebar [:!Ta :spacebar]] ; cycle layouts


                 ; move window left/right (require custom config)
                 [:-m [:!Ta :!Tj]] ; move between panes
                 [:comma [:!Ta :!Tk]] ; move between panes

                 [:-n [:!Ta :p]] ; prev window
                 [:-e [:!Ta :n]] ; next window

                 [:-u [:!Ta :u]] ; prev agent (herdr)
                 [:-y [:!Ta :y]] ; next agent (herdr)
                 [:-i [:!Ta :o]] ; jump to agent needing attention (herdr)
                 [:-p [:!Ta :!Tp]] ; project picker (herdr-plus)
                 ;[:-o [:!Ta :w]] ; list windows 
                 [:return_or_enter [:!Ta :open_bracket]] ; copy mode
                 ;;
                 ]}

        {:des "rex-shortcuts"
         :rules [:rex
                 ;; a-mode mirrors the tmux a-mode above, but sends rex's own default
                 ;; shortcuts instead of a tmux prefix (no rex config needed).
                 ;; tmux "window" == rex "tab", tmux "pane" == rex "pane".
                 [:condi :rex :a-mode]
                 [:-j :!COdown_arrow] ; focus pane down (cmd+opt+arrow)
                 [:-k :!COup_arrow] ; focus pane up
                 [:-h :!COleft_arrow] ; focus pane left
                 [:-l :!COright_arrow] ; focus pane right
                 [:-u :!Copen_bracket] ; focus previous pane (cmd+[)
                 [:-y :!Cclose_bracket] ; focus next pane (cmd+])
                 [:-o :!CSreturn_or_enter] ; zoom / restore pane (cmd+shift+enter)
                 [:-x :!Cw] ; close pane (cmd+w)
                 [:delete :!Cw] ; close pane
                 [:-c :!Ct] ; new tab (cmd+t) == tmux new window
                 [:-t :!CSn] ; new session (cmd+shift+n)
                 [:-r :!CSp] ; command palette (cmd+shift+p); rename tab has no default shortcut in rex
                 [:-semicolon :!Ck] ; change session (cmd+k) == tmux last-session
                 [:-p :!CSg] ; go to directory (cmd+shift+g) == project picker
                 [:hyphen :!CSd] ; split down (cmd+shift+d)
                 [:-v :!Cd] ; split right (cmd+d)
                 [:spacebar :!Creturn_or_enter] ; split where there is most room (cmd+enter)

                 [:-m :!TSpage_up] ; move tab backward (ctrl+shift+pageup)
                 [:comma :!TSpage_down] ; move tab forward (ctrl+shift+pagedown)

                 [:-n :prev_tab] ; previous tab (ctrl+shift+tab)
                 [:-e :next_tab] ; next tab (ctrl+tab)
                 ;; no rex default for: toggle sidebar (-s), copy mode (return), cycle layouts
                 ;;
                 ]}

        {:des "emoji z-mode"
         :rules [:emoji-mode
                 [:-t [:paste "👍"]] ; thumbsup
                 [:left_option [:paste "👎"]]
                 [:-b [:paste "🐛"]] ; bug
                 [:-d [:paste "📚"]] ; docs
                 [:-p [:paste "🎉"]] ; party, tada
                 [:-l [:paste "❤️"]] ; love
                 [:-j [:paste "😂"]] ; joking
                 [:-h [:paste "😀"]] ; happy
                 [:-r [:paste "🤣"]] ; rofl
                 [:-s [:paste "😢"]] ; sad
                 [:-c [:paste "😭"]] ; cry
                 ;;
                 ]}

        {:des   "escape mode"
         :rules [:escape-mode
                 [:return_or_enter [:open-new-osa "Ghostty"]]
                 [:period  [:open-new "/Applications/Brave Browser.app"]]

                 [:-n :prev_app]
                 [:-e :next_app]
                 [:-i [:activate "Rex Beta"]]
                 [:-f [:launch "Finder"]]
                 [:-o :switch_windows]
                 [:-d :f11] ; show desktop
                 [:-t :!Ospacebar] ; leaderkey
                 [:delete :!Cw]

                 ; [:delete "yabai -m window --close"]

                 [:-c :!!c] ; open calendar
                 [:-w :!!w]                 
                 [:-a :!!a] ; toggle menubar (bartenter)
                 [:-p :!!p] ; take a screenshot 

                 [:-g :!!g] ; used for presentify

                 [:-k :!!k]

                 [:-m [:launch "Music"]]
                 [:-s [:launch "Discord"]] ; active work chat app
                 [:-b [:launch "Brave"]]
                 [:-v :!!v]
                 [:comma [:launch "Messenger"]]
                 [:-l :!!l] ; toggle 1password
                 [:slash [:launch "Obsidian"]]
                 [:spacebar :!Csemicolon] ; for kit
                 [:-z [:quit "logioptionsplus_agent"]]
                 
                 ;;
                 ]}

        {:des "tab-mode"
         :rules [:tab-mode
                 [:-a :!!a] ; open launchpad
                 [:-t :!Tf3] ; focus dock
                 [:-s :!!s] ; toggle top menubar (bartender)

                 ;; moom
                 [:-n :!!1]
                 [:-u :!!2]
                 [:-e :!!2]
                 [:-i :!!3]

                 [:-m :!!4]
                 [:comma :!!5]
                 [:period :!!6]

                 [:-y :!!7]
                 [:-l :!!8]

                 ;;
                 ]}

        {:des "spacebar space-mode"
         :rules [:spacebar-mode
                 [:-a :!S1]
                 [:-r :!Shyphen]
                 [:-s :hyphen]
                 [:-t :!Ssemicolon]
                 [:-c :!Sequal_sign]

                 [:-n :open_brace]
                 [:-e :close_brace]
                 [:-i :equal_sign]
                 [:-o :greater_than]
                 [:-l :open_paren]
                 [:-u :close_paren]

                 [:-m :open_bracket]
                 [:comma :close_bracket]

                 ;; [:j :open_brace]
                 ;; [:k :close_brace]

                 ;; [:l :less_than]
                 ;; [:semicolon :greater_than]

                 ;; symbol sequences
                 [:left_shift [:spacebar :equal_sign :spacebar]]; =  =  =  =  =  =  =  =  =  =
                 [:q [:!S9 :!S0 :equal_sign :greater_than :spacebar]]; ()=>
                 [:e [:!S9 :!S9 :!S0 :equal_sign :greater_than :spacebar :open_brace :close_brace :!S0 :left_arrow :left_arrow]]; (()=> {})

                 [:g [:spacebar :equal_sign :greater_than :spacebar]]; =>  => ={} =""
                 [:h [:equal_sign :open_brace :close_brace :left_arrow]]; ={}
                 [:b [:equal_sign :open_brace :close_brace :left_arrow]]; ={}
                 [:quote [:equal_sign :!Squote :!Squote :left_arrow]]; =""
                 ;;
                 ]}

        {:des "a-mode (global)"
         :rules [:a-mode
                 [:-c :!Cc] ; copy
                 [:-v :!Cv] ; paste
                 [:-f :!Cf] ; find
                 ;;
                 ]}

        ;; Homerow mods: hold >= 200ms -> modifier, tap -> colemak letter.
        ;; Pressing another key before 200ms cancels the hold and types the letter,
        ;; so fast rolls never turn into shortcuts. Keep :held and :delay equal.
        ;; :alone is longer on purpose: a tap released within 300ms with no other key
        ;; pressed still types the letter, even if the modifier already kicked in.
        ;; Must stay after every layer rule and before "colemak".
        {:des "homerow mods"
         :rules [;;
                 [:##s nil nil {:alone {:key :r :halt true} :held :left_control :delayed {:canceled :r}
                                 :params {:alone 300 :held 150 :delay 150}}] ; r -> left ctrl
                 [:##d nil nil {:alone {:key :s :halt true} :held :left_shift :delayed {:canceled :s}
                                 :params {:alone 300 :held 200 :delay 200}}] ; s -> left shift
                 [:##f nil nil {:alone {:key :t :halt true} :held :left_command :delayed {:canceled :t}
                                 :params {:alone 300 :held 200 :delay 200}}] ; t -> left cmd
                 [:##j nil nil {:alone {:key :n :halt true} :held :right_command :delayed {:canceled :n}
                                 :params {:alone 300 :held 200 :delay 200}}] ; n -> right cmd
                 [:##k nil nil {:alone {:key :e :halt true} :held :right_shift :delayed {:canceled :e}
                                 :params {:alone 300 :held 200 :delay 200}}] ; e -> right shift
                 [:##l nil nil {:alone {:key :i :halt true} :held :right_control :delayed {:canceled :i}
                                 :params {:alone 300 :held 200 :delay 200}}] ; i -> right ctrl
                 [:##semicolon nil nil {:alone {:key :o :halt true} :held :left_option :delayed {:canceled :o}
                                 :params {:alone 300 :held 200 :delay 200}}] ; o -> left alt
                 ;;
                 ]}

        ;; s d f j k l ; are handled by "homerow mods" above
        {:des "colemak"
         :rules [;;
                 [:##e :f]
                 [:##r :p]
                 [:##t :g]
                 [:##y :j]
                 [:##u :l]
                 [:##i :u]
                 [:##o :y]
                 [:##p :semicolon]

                 [:##g :d]

                 [:##n :k]
                 ;;
                 ]}
        ;;
        ]}
;; rule [:period ["media-mode" 1] nil {:afterup ["media-mode" 0] :alone :period}]
;;       |_____| |_______________| |_| |_________________________________________|
;;        <from>    <to>      <conditions>         <other options>

;; !  | means mandatory
;; #  | means optional
;; C  | left_command
;; T  | left_control
;; O  | left_option
;; S  | left_shift
;; F  | fn
;; Q  | right_command
;; W  | right_control
;; E  | right_option
;; R  | right_shift
;; 
;; !! | mandatory command + control + optional + shift (hyper)
;; ## | optional any
;; 
